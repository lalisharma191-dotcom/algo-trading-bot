# Copy this file to .env and fill in your values.
# MODE=paper is SAFE (fake money). Only set MODE=live after testing.

MODE=paper

# Needed only for MODE=live
BINANCE_API_KEY=
BINANCE_API_SECRET=

SYMBOL=BTCUSDT
INTERVAL=15m

# Risk settings
START_BALANCE=1000
RISK_PER_TRADE=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_DAILY_LOSS_PCT=0.05
